    { "id": "hall-light", "name": "Hall Light", "kind": "relay", "state": false },
    { "id": "bathroom-fan", "name": "Bathroom Fan", "kind": "relay", "state": false },
    { "id": "radiator", "name": "Radiator", "kind": "relay", "state": false },
    { "id": "hall-motion", "name": "Hall Motion", "kind": "sensor", "state": false },
